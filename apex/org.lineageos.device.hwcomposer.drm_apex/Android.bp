apex {
    name: "org.lineageos.device.hwcomposer.drm_apex",
    defaults: ["com.android.hardware.graphics.composer.drm_hwcomposer_upstream_defaults"],
    manifest: "apex_manifest.json",
    prebuilts: [
        "org.lineageos.device.hwcomposer.drm_apex.rc",
    ],
}

genrule {
    name: "gen-org.lineageos.device.hwcomposer.drm_apex.rc",
    srcs: [":drm_hwcomposer_init_rc_upstream"],
    out: ["org.lineageos.device.hwcomposer.drm_apex.rc"],
    cmd: "sed -E 's%/vendor/bin/%/apex/org.lineageos.device.hwcomposer/bin/%;s%vendor.hwcomposer-3.drm_upstream%vendor.hwcomposer-3.drm_upstream-apex%' $(in) > $(out)",
}

prebuilt_etc {
    name: "org.lineageos.device.hwcomposer.drm_apex.rc",
    src: ":gen-org.lineageos.device.hwcomposer.drm_apex.rc",
    installable: false,
}
