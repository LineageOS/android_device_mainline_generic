import /vendor/etc/init/hw/init.mainline.rc

# Console
service console_hvc0 /system/bin/sh
    class core
    console hvc0
    disabled
    user root
    group root shell log readproc
    seclabel u:r:su:s0
    setenv HOSTNAME console
    shutdown critical

service console_ttyS0 /system/bin/sh
    class core
    console ttyS0
    disabled
    user root
    group root shell log readproc
    seclabel u:r:su:s0
    setenv HOSTNAME console
    shutdown critical
    oneshot

on init
    start console_hvc0
    start console_ttyS0

# Display
on early-init
    setprop ro.sf.lcd_density ${ro.boot.lcd_density:-160}

on property:ro.hardware.gralloc=default && property:sys.bootstat.first_boot_completed=1
    write /sys/class/vtconsole/vtcon0/bind 0
    write /sys/class/vtconsole/vtcon1/bind 0

# Light
service vendor.light-default /vendor/bin/hw/android.hardware.light-service.lineage
    class hal
    user root
    group root
    shutdown critical
    override

# Kernel modules
on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules zram.ko

# Mount
on late-fs
    setprop ro.crypto.state unsupported
    trigger nonencrypted
