ifeq ($(USES_DEVICE_MAINLINE_GENERIC),true)

FILTER_DEBIAN_KCONFIG_SECTIONS_SCRIPT := $(DEVICE_PATH)/configs/kernel/filter_debian_kconfig_sections.py

DEBIAN_KCONFIG_SECTIONS_BLACKLIST := $(DEVICE_PATH)/configs/kernel/debian_kconfig_sections_blacklist.txt

DEBIAN_KERNEL_CONFIG_DIR := external/debian-linux/debian/config

DEBIAN_ORIGINAL_KERNEL_CONFIGS := $(DEBIAN_KERNEL_CONFIG_DIR)/config
ifeq ($(TARGET_ARCH),arm64)
DEBIAN_ORIGINAL_KERNEL_CONFIGS += $(DEBIAN_KERNEL_CONFIG_DIR)/arm64/config
else ifeq ($(TARGET_ARCH),x86_64)
DEBIAN_ORIGINAL_KERNEL_CONFIGS += $(DEBIAN_KERNEL_CONFIG_DIR)/amd64/config
endif

DEBIAN_FILTERED_KERNEL_CONFIG := $(PRODUCT_OUT)/obj/KCONFIG_OBJ/debian-filtered.config

$(DEBIAN_FILTERED_KERNEL_CONFIG): $(FILTER_DEBIAN_KCONFIG_SECTIONS_SCRIPT) $(DEBIAN_KCONFIG_SECTIONS_BLACKLIST) $(DEBIAN_ORIGINAL_KERNEL_CONFIGS)
	python3 $(FILTER_DEBIAN_KCONFIG_SECTIONS_SCRIPT) -o $@ -p $(DEBIAN_KCONFIG_SECTIONS_BLACKLIST) $(DEBIAN_ORIGINAL_KERNEL_CONFIGS)

endif # USES_DEVICE_MAINLINE_GENERIC
