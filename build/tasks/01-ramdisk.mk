ifeq ($(USES_DEVICE_MAINLINE_GENERIC),true)

INSTALLED_RAMDISK_CUSTOM_CPIO_TARGET := $(PRODUCT_OUT)/ramdisk-custom.cpio
INSTALLED_RAMDISK_CUSTOM_TARGET := $(PRODUCT_OUT)/ramdisk-custom.img
RAMDISK_CUSTOM_SOURCE_DIR := $(DEVICE_PATH)/prebuilts/ramdisk

INSTALLED_RAMDISK_ALL_COMBINED_TARGET := $(PRODUCT_OUT)/ramdisk-all-combined.img
INSTALLED_RAMDISK_ALL_COMBINED_TARGET_DEPS := \
    $(PRODUCT_OUT)/ramdisk.img \
    $(INSTALLED_RAMDISK_CUSTOM_TARGET)

$(INSTALLED_RAMDISK_CUSTOM_TARGET):
	$(MKBOOTFS) -d $(TARGET_OUT) $(RAMDISK_CUSTOM_SOURCE_DIR) > $(INSTALLED_RAMDISK_CUSTOM_CPIO_TARGET)
	$(COMPRESSION_COMMAND) < $(INSTALLED_RAMDISK_CUSTOM_CPIO_TARGET) > $@

$(INSTALLED_RAMDISK_ALL_COMBINED_TARGET): $(INSTALLED_RAMDISK_ALL_COMBINED_TARGET_DEPS)
	cat $^ > $@

.PHONY: ramdisk_all_combined ramdisk_custom
ramdisk_all_combined: $(INSTALLED_RAMDISK_ALL_COMBINED_TARGET)
ramdisk_custom: $(INSTALLED_RAMDISK_CUSTOM_TARGET)

endif # USES_DEVICE_MAINLINE_GENERIC
