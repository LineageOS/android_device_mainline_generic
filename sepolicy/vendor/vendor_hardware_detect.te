type vendor_hardware_detect, domain;
type vendor_hardware_detect_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_hardware_detect);

allow vendor_hardware_detect gpu_device:dir r_dir_perms;
allow vendor_hardware_detect gpu_device:chr_file { getattr ioctl map open read write };

r_dir_file(vendor_hardware_detect, audio_device)
