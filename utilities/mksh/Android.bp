cc_binary {
    name: "sh_vendor_bootstrap",
    defaults: ["mksh_defaults"],
    relative_install_path: "bootstrap",
    stem: "sh",
    bootstrap: true,
    vendor: true,
    // Even though sh_vendor is only built for device these flags need to be in a target: android:
    // for ordering reasons with the flags from the default modules.
    target: {
        android: {
            cflags: [
                // Additional flags for vendor variant
                "-UMKSH_DEFAULT_PROFILEDIR",
                "-UMKSHRC_PATH",
                "-UMKSH_DEFAULT_EXECSHELL",
                "-DMKSH_DEFAULT_PROFILEDIR=\"/vendor/etc\"",
                "-DMKSHRC_PATH=\"/vendor/etc/mkshrc\"",
                "-DMKSH_DEFAULT_EXECSHELL=\"/vendor/bin/bootstrap/sh\"",
                "-DMKSH_DEFPATH_OVERRIDE=\"/vendor/bin/bootstrap:/vendor/bin:/vendor/xbin\"",
            ],
        },
    },
}
